# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local tooling output — screenshot/debug artifacts from browser automation.
# These were picked up by accidental `git add -A` commits more than once.
.shots/
.playwright-mcp/

# iCloud placeholder stubs, in case a copy of this repo ever sits in a
# synced folder again. node_modules under iCloud evicts to dataless files
# and breaks `next dev` with ERR_INVALID_PACKAGE_CONFIG.
*.icloud

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
